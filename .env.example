# Federated Cyber Shield (FCS) v1.2 - Development Configuration Template
# DO NOT PUT REAL SECRETS OR CLOUD CREDENTIALS HERE
# Zero-cost policy: All settings default to local/in-memory/sqlite operation

# Environment Mode: development | test | simulation | production_deferred
FCS_ENVIRONMENT=development
FCS_DEBUG=true

# Collector Configuration
FCS_COLLECTOR_HOST=127.0.0.1
FCS_COLLECTOR_PORT=2055
FCS_COLLECTOR_PROTOCOL=ipfix
FCS_COLLECTOR_BUFFER_SIZE=65536
FCS_COLLECTOR_WORKERS=2
FCS_MAX_PACKET_SIZE_BYTES=65507

# Stream Adapter Configuration: memory | sqlite | kinesis
FCS_STREAM_SINK_TYPE=memory
FCS_SQLITE_DB_PATH=data/fcs_telemetry.sqlite

# AWS Kinesis Deferred Config (Disabled by default, no cloud credentials needed)
FCS_AWS_REGION=us-east-1
FCS_AWS_KINESIS_STREAM_NAME=fcs-telemetry-stream-dev
FCS_AWS_KINESIS_ENABLED=false

# Security & Multi-Tenancy
FCS_DEFAULT_TENANT_ID=tenant-alpha-rural-isp
FCS_STRICT_TENANT_VERIFICATION=true
FCS_AUDIT_LOG_ENABLED=true

# Metrics & Observability
FCS_METRICS_ENABLED=true
FCS_METRICS_INTERVAL_SECONDS=10
FCS_LOG_LEVEL=INFO
FCS_STRUCTURED_LOGS=true
