# FCS Backend Container: Development / Integration
FROM python:3.12-slim

# Security: Install minimal required runtime packages and create unprivileged user
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    sqlite3 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 10001 fcsgroup \
    && useradd -u 10001 -g fcsgroup -m -s /bin/bash fcsuser

WORKDIR /app

# Copy dependency specifications first for cache optimization
COPY requirements.txt pyproject.toml /app/
RUN pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir -e . --no-deps

# Copy application source code
COPY . /app/

# Set ownership to unprivileged user
RUN chown -R fcsuser:fcsgroup /app

USER fcsuser

ENV PYTHONUNBUFFERED=1 \
    FCS_ENV=development \
    FCS_DB_PATH=/app/data/fcs_phase4.db

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://127.0.0.1:8000/healthz || exit 1

CMD ["python", "-m", "tools.fcs_cli", "api", "start", "--host", "0.0.0.0", "--port", "8000"]
